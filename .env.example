# Multi-user book/ledger sync (see docs/MULTI_USER_SYNC_SCOPE.md).
# Copy this to .env.local (gitignored) and fill in the real values from
# the Bejirond Supabase project's Settings > API page.
# The app works fine with these unset — sync is opt-in per ledger; a
# missing config just means the "Share this business" action isn't
# available yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
